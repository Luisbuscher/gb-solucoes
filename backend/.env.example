# ============================================================================
# APLICAÇÃO — HTTP local; em produção use URL HTTPS e COOKIE_SECURE=true
# ============================================================================
PORT=3001
APP_URL=http://localhost:3000
TZ=America/Sao_Paulo
COOKIE_SECURE=false
REQUIRE_HTTPS=false

# ============================================================================
# POSTGRESQL EXTERNO — DATABASE_URL é montada automaticamente
# localhost é traduzido para host.docker.internal somente dentro do Docker
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gastomensal
DB_SSL=false
# Arquivo CA em /app/secrets para PostgreSQL externo com certificado privado
DB_SSL_CA_FILE=

# ============================================================================
# SEGURANÇA E ADMINISTRAÇÃO — obrigatórias; nunca publicar este arquivo
# Gere chaves com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
ADMIN_EMAIL=admin@blabla.local
ADMIN_PASSWORD=
DATA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# ============================================================================
# GOOGLE CLOUD STORAGE — preencha JSON OU arquivo, nunca ambos
# O arquivo deve estar em backend/secrets e usar caminho /app/secrets no Docker
# ============================================================================
GCS_SERVICE_ACCOUNT_JSON=
GCS_SERVICE_ACCOUNT_FILE=
GCS_BUCKET_NAME=

# ============================================================================
# ENTREGA DE E-MAIL — domínio do remetente precisa estar verificado no Resend
# ============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL='GB Soluções <contato@seudominio.com>'

# ============================================================================
# BACKUP NO HOST — chaves devem ser guardadas também em local seguro separado
# PG_BIN pode apontar para a pasta bin do PostgreSQL no Windows
# ============================================================================
PG_BIN=C:/Program Files/PostgreSQL/16/bin
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
